# Azure OpenAI — text + vision (gpt-5.5)
AZURE_API_KEY=your-azure-key
OPENAI_API_KEY=your-azure-key
OPENAI_BASE_URL=https://your-resource.cognitiveservices.azure.com/openai/v1/
COPILOT_MODEL=gpt-5.5
OPENAI_VALIDATION_MODEL=gpt-5.5

# Azure gpt-image-2 — image generation + edits
AZURE_IMAGE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/openai/deployments/gpt-image-2/images/generations?api-version=2024-02-01
AZURE_IMAGE_EDIT_ENDPOINT=https://your-resource.cognitiveservices.azure.com/openai/deployments/gpt-image-2/images/edits?api-version=2025-04-01-preview

# Azure Blob Storage — optional, for publishing artifacts
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=kdp-books

# Image rendering defaults
IMAGE_SIZE=2048x2048
IMAGE_QUALITY=high
IMAGE_GENERATION_WORKERS=4

# Run defaults
KDP_BOOKS_DIR=books
KDP_AUTHOR_NAME=Anonymous
